# Supabase > Project Settings > Database > Connection string
# "Connection pooling" (Transaction mode, port 6543) — used by the app at runtime.
# Keep the "?pgbouncer=true" query param that Supabase includes when you copy it.
DATABASE_URL="postgresql://postgres.xxxxxxxx:[YOUR-PASSWORD]@aws-0-ap-northeast-2.pooler.supabase.com:6543/postgres?pgbouncer=true"

# "Direct connection" (port 5432) — used only by Prisma Migrate (schema changes), never by the app.
DIRECT_URL="postgresql://postgres.xxxxxxxx:[YOUR-PASSWORD]@aws-0-ap-northeast-2.pooler.supabase.com:5432/postgres"

# Claude API key for the AI tutor route (app/api/ai-tutor/route.ts)
ANTHROPIC_API_KEY="sk-ant-xxxxxxxx"

# 로그인 쿠키 서명용 비밀값(32자 이상의 무작위 문자열). 비어 있으면 운영에서는 아무도 로그인할 수 없다.
# 만들기: node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
SESSION_SECRET="change-me-to-a-random-string-at-least-32-chars"

# AI 대화 암호화 키(base64로 인코딩한 32바이트). 잃어버리거나 바꾸면 예전 대화를 읽을 수 없으니 앱 밖에 따로 보관한다.
# 만들기: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
CHAT_ENCRYPTION_KEY="change-me"
