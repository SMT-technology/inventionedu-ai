// Prisma schema for 로봇 관절 도우미 (중학교 로봇팔 프로젝트 웹앱)
// 2026-10-08 초기화: 발명 웹앱 스키마를 비우고 새로 시작. 로그인 보안(PIN 등)은 이후 단계에서 추가.
// enum-like fields are typed as String (documented via comments below).

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL") // Supabase "Connection pooling" URI (port 6543, pgbouncer)
  directUrl = env("DIRECT_URL")   // Supabase "Direct connection" URI (port 5432), used for migrations
}

generator client {
  provider = "prisma-client-js"
}

/// role: "teacher" | "student"
model User {
  id        String   @id @default(cuid())
  email     String   @unique
  name      String
  role      String
  classId   String?
  teamId    String?
  createdAt DateTime @default(now())

  class         Class?     @relation(fields: [classId], references: [id])
  team          Team?      @relation(fields: [teamId], references: [id])
  progress      Progress[]
  taughtClasses Class[]    @relation("ClassTeacher")
}

model Class {
  id        String   @id @default(cuid())
  teacherId String
  name      String
  createdAt DateTime @default(now())

  teacher  User   @relation("ClassTeacher", fields: [teacherId], references: [id])
  students User[]
  teams    Team[]
}

/// 2인 1조 모둠
model Team {
  id        String   @id @default(cuid())
  classId   String
  name      String
  createdAt DateTime @default(now())

  class   Class  @relation(fields: [classId], references: [id])
  members User[]
}

/// step: 1~7 (학생 활동 단계, lib/steps.ts)
/// status: "not_started" | "in_progress" | "done"
model Progress {
  id        String   @id @default(cuid())
  userId    String
  step      Int
  status    String   @default("not_started")
  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [id])

  @@unique([userId, step])
}
