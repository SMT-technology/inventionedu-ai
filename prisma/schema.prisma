// Prisma schema for the 발명 메이커 랩 (invention education) app
// Note: enum-like fields are typed as String (documented via comments below)
// so the same schema stays portable if the DB provider ever changes again.

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL") // Supabase "Connection pooling" URI (port 6543, pgbouncer)
  directUrl = env("DIRECT_URL")   // Supabase "Direct connection" URI (port 5432), used for migrations
}

generator client {
  provider = "prisma-client-js"
}

/// role: "teacher" | "student"
/// boardType: "arduino" | "microbit" | null — 5단계(실행하기)에서만 선택
model User {
  id        String   @id @default(cuid())
  email     String   @unique
  name      String
  role      String
  classId   String?
  boardType String?
  createdAt DateTime @default(now())

  class       Class?       @relation(fields: [classId], references: [id])
  progress    Progress[]
  submissions Submission[]
  taughtClasses Class[]    @relation("ClassTeacher")
}

model Class {
  id        String   @id @default(cuid())
  teacherId String
  name      String
  createdAt DateTime @default(now())

  teacher  User   @relation("ClassTeacher", fields: [teacherId], references: [id])
  students User[]
}

/// stage: 1~6 (발명 문제해결 6단계, lib/stages.ts)
/// status: "not_started" | "in_progress" | "done"
model Progress {
  id        String   @id @default(cuid())
  userId    String
  stage     Int
  status    String   @default("not_started")
  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [id])

  @@unique([userId, stage])
}

/// stage: 1~6 (lib/stages.ts)
/// One row = one record card in a stage (발견한 문제, 아이디어, 제작 기록 등); many per stage.
model Submission {
  id        String   @id @default(cuid())
  userId    String
  stage     Int
  title     String
  content   String
  imageUrl  String?
  feedback  String?
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id])
}
