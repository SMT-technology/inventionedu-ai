// Prisma schema for the 메이커 튜터 (창의적 전자제품 만들기) app
// Note: enum-like fields are typed as String (documented via comments below)
// so the same schema stays portable if the DB provider ever changes again.

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL") // Supabase "Connection pooling" URI (port 6543, pgbouncer)
  directUrl = env("DIRECT_URL")   // Supabase "Direct connection" URI (port 5432), used for migrations
}

generator client {
  provider = "prisma-client-js"
}

/// role: "teacher" | "student"
/// boardType: "arduino" | "microbit" | null — 이전 컨셉의 유물, 현재 화면에서는 쓰지 않음
model User {
  id        String   @id @default(cuid())
  email     String   @unique
  name      String
  role      String
  classId   String?
  boardType String?
  createdAt DateTime @default(now())

  class        Class?        @relation(fields: [classId], references: [id])
  progress     Progress[]
  submissions  Submission[]
  threeDModels ThreeDModel[]
  taughtClasses Class[]      @relation("ClassTeacher")
}

model Class {
  id        String   @id @default(cuid())
  teacherId String
  name      String
  createdAt DateTime @default(now())

  teacher  User   @relation("ClassTeacher", fields: [teacherId], references: [id])
  students User[]
}

/// stage: 1~3 (Maker's Tutor 3단계, lib/stages.ts)
/// status: "not_started" | "in_progress" | "done"
model Progress {
  id        String   @id @default(cuid())
  userId    String
  stage     Int
  status    String   @default("not_started")
  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [id])

  @@unique([userId, stage])
}

/// stage: 1~3 (lib/stages.ts)
/// One row = one record card in a stage (배운 점, 아이디어 스케치, 실험 기록 등); many per stage.
model Submission {
  id        String   @id @default(cuid())
  userId    String
  stage     Int
  title     String
  content   String
  imageUrl  String?
  feedback  String?
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id])
}

/// stage 진행(1~3)과는 별개의 독립 기능 — Meshy AI로 아이디어를 3D 모델로 미리 본다.
/// status: "pending" | "done" | "failed"
model ThreeDModel {
  id         String   @id @default(cuid())
  userId     String
  prompt     String
  status     String   @default("pending")
  resultUrl  String?
  taskId     String?
  createdAt  DateTime @default(now())

  user User @relation(fields: [userId], references: [id])
}
